{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.local/schemas/obsidian-reconciler-registry.schema.json",
  "title": "Aegis Obsidian reconciler project registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "projects"],
  "properties": {
    "schema_version": {"const": "1"},
    "export_dir": {"type": "string", "pattern": "^/"},
    "export_max_age_seconds": {"type": "integer", "minimum": 60, "maximum": 3600, "default": 600},
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "enabled", "target_dir", "output_dir", "bead_export_argv"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "enabled": {"type": "boolean"},
          "target_dir": {"type": "string", "pattern": "^/"},
          "output_dir": {"type": "string", "pattern": "^/"},
          "bead_export_argv": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "bead_gate_paths": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^/.*\\.gate\\.lock$"}
          },
          "include_bead_content": {"type": "boolean", "default": false},
          "freshness_sla_seconds": {"type": "integer", "minimum": 60, "maximum": 86400, "default": 180},
          "min_interval_seconds": {"type": "integer", "minimum": 0, "maximum": 300, "default": 10},
          "export_timeout_seconds": {"type": "integer", "minimum": 5, "maximum": 120, "default": 30},
          "live_index": {
            "type": "object",
            "additionalProperties": false,
            "required": ["obsidian_cli", "vault", "probe_path"],
            "properties": {
              "obsidian_cli": {"type": "string", "pattern": "^/"},
              "vault": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
              "probe_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.md$"},
              "timeout_seconds": {"type": "integer", "minimum": 5, "maximum": 60, "default": 15}
            }
          }
        }
      }
    }
  }
}
