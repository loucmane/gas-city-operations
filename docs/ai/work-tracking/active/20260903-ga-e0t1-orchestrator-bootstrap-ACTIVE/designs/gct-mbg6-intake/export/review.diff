+            "claude-opus-5-5",
+            "--effort",
+            "max",
+            "--permission-mode",
+            "dontAsk",
+            "--settings",
+            str(config.control_policy),
+            "--add-dir",
+            str(config.add_dirs[0]),
+        ]
+    )
+    if not resume:
+        arguments.extend(["--settings", str(config.shared_settings)])
+    return arguments
